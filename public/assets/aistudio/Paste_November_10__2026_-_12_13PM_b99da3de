<style>

:root{
    --primary:#4b001f;
    --primary-dark:#350016;
    --pink:#f7dce8;
    --pink-light:#fff6fa;
    --gold:#c9973e;
    --text:#202020;
    --muted:#777;
    --white:#fff;
    --border:#eadfe4;
    --shadow:0 15px 45px rgba(75,0,31,.10);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:"DM Sans",sans-serif;
    color:var(--text);
    background:#fff;
}

a{
    text-decoration:none;
    color:inherit;
}

button,
input,
select{
    font-family:inherit;
}

.container{
    width:min(1180px,92%);
    margin:auto;
}

/* HEADER */

header{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(255,255,255,.96);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--border);
}

.navbar{
    height:76px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    display:flex;
    align-items:center;
    gap:10px;
}

.logo-mark{
    width:44px;
    height:44px;
    border-radius:13px;
    background:var(--primary);
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:22px;
    font-weight:700;
}

.logo-text{
    font-family:"Playfair Display",serif;
    font-size:22px;
    color:var(--primary);
    font-weight:700;
}

.nav-links{
    display:flex;
    gap:28px;
    align-items:center;
}

.nav-links a{
    color:#555;
    font-size:14px;
    font-weight:600;
}

.nav-links a:hover{
    color:var(--primary);
}

.nav-buttons{
    display:flex;
    gap:10px;
}

.btn{
    border:none;
    padding:12px 19px;
    border-radius:10px;
    font-weight:700;
    cursor:pointer;
    transition:.2s;
}

.btn-primary{
    background:var(--primary);
    color:#fff;
}

.btn-primary:hover{
    background:var(--primary-dark);
}

.btn-outline{
    background:#fff;
    color:var(--primary);
    border:1px solid var(--primary);
}

.btn-outline:hover{
    background:var(--pink-light);
}

.menu-btn{
    display:none;
    border:none;
    background:none;
    font-size:25px;
    cursor:pointer;
}

/* HERO */

.hero{
    background:
    radial-gradient(circle at 80% 20%,#f7dce8 0,transparent 32%),
    linear-gradient(135deg,#fff 0%,#fff6fa 100%);
    padding:85px 0 90px;
    overflow:hidden;
}

.hero-grid{
    display:grid;
    grid-template-columns:1.1fr .9fr;
    gap:50px;
    align-items:center;
}

.hero-small{
    display:inline-block;
    background:var(--pink);
    color:var(--primary);
    padding:8px 14px;
    border-radius:30px;
    font-size:13px;
    font-weight:700;
    margin-bottom:18px;
}

.hero h1{
    font-family:"Playfair Display",serif;
    color:var(--primary);
    font-size:58px;
    line-height:1.08;
    margin-bottom:20px;
}

.hero h1 span{
    color:var(--gold);
}

.hero p{
    color:var(--muted);
    font-size:17px;
    line-height:1.8;
    max-width:600px;
}

.hero-buttons{
    display:flex;
    gap:12px;
    margin-top:28px;
}

.hero-image{
    position:relative;
    min-height:430px;
    display:flex;
    align-items:center;
    justify-content:center;
}

.hero-circle{
    width:350px;
    height:350px;
    border-radius:50%;
    background:var(--pink);
    position:absolute;
}

.hero-card{
    position:relative;
    width:280px;
    min-height:340px;
    background:#fff;
    border-radius:25px;
    box-shadow:var(--shadow);
    border:1px solid var(--border);
    padding:22px;
    z-index:2;
    text-align:center;
}

.hero-avatar{
    width:150px;
    height:150px;
    border-radius:50%;
    margin:auto;
    background:var(--pink);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:55px;
    color:var(--primary);
    overflow:hidden;
}

.hero-avatar img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.hero-card h3{
    font-family:"Playfair Display",serif;
    color:var(--primary);
    margin-top:18px;
}

.hero-card p{
    font-size:13px;
    margin-top:5px;
}

.float-card{
    position:absolute;
    background:#fff;
    box-shadow:var(--shadow);
    border:1px solid var(--border);
    padding:13px 17px;
    border-radius:12px;
    font-size:13px;
    font-weight:700;
    z-index:4;
}

.float-one{
    top:50px;
    right:0;
}

.float-two{
    bottom:55px;
    left:0;
}

/* SEARCH */

.search-section{
    margin-top:-40px;
    position:relative;
    z-index:5;
}

.search-box{
    background:#fff;
    border:1px solid var(--border);
    box-shadow:var(--shadow);
    border-radius:20px;
    padding:25px;
}

.search-title{
    color:var(--primary);
    font-family:"Playfair Display",serif;
    font-size:24px;
    margin-bottom:18px;
}

.search-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr) auto;
    gap:12px;
}

.input{
    width:100%;
    padding:13px;
    border:1px solid var(--border);
    border-radius:10px;
    outline:none;
    background:#fff;
}

.input:focus{
    border-color:var(--primary);
}

/* SECTION */

section{
    padding:80px 0;
}

.section-heading{
    text-align:center;
    margin-bottom:45px;
}

.section-heading span{
    color:var(--gold);
    font-size:13px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:1px;
}

.section-heading h2{
    font-family:"Playfair Display",serif;
    color:var(--primary);
    font-size:38px;
    margin-top:8px;
}

.section-heading p{
    color:var(--muted);
    margin-top:10px;
}

/* HOW IT WORKS */

.steps{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.step{
    text-align:center;
    padding:30px;
    background:var(--pink-light);
    border:1px solid var(--border);
    border-radius:18px;
}

.step-icon{
    width:58px;
    height:58px;
    border-radius:50%;
    margin:auto;
    background:var(--primary);
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:22px;
}

.step h3{
    color:var(--primary);
    margin:18px 0 8px;
}

.step p{
    color:var(--muted);
    line-height:1.7;
}

/* PROFILES */

.profile-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.profile-card{
    background:#fff;
    border:1px solid var(--border);
    border-radius:18px;
    overflow:hidden;
    box-shadow:0 8px 30px rgba(75,0,31,.06);
    transition:.25s;
}

.profile-card:hover{
    transform:translateY(-5px);
    box-shadow:var(--shadow);
}

.profile-photo{
    height:250px;
    background:var(--pink);
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
}

.profile-photo img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.profile-placeholder{
    font-size:65px;
    color:var(--primary);
}

.profile-info{
    padding:17px;
}

.profile-name{
    color:var(--primary);
    font-family:"Playfair Display",serif;
    font-size:20px;
}

.profile-location{
    color:var(--muted);
    font-size:13px;
    margin:5px 0 12px;
}

.profile-tags{
    display:flex;
    flex-wrap:wrap;
    gap:5px;
}

.tag{
    background:var(--pink-light);
    border:1px solid var(--border);
    padding:5px 8px;
    border-radius:20px;
    font-size:10px;
    color:var(--primary);
}

.profile-actions{
    display:flex;
    gap:7px;
    margin-top:15px;
}

.profile-actions button{
    flex:1;
}

