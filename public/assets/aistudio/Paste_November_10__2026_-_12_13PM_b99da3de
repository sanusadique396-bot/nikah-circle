/* ==============================
   GLOBAL
============================== */

let allProfiles = [];
let currentUser = null;


/* ==============================
   LOAD USER
============================== */

async function checkUser(){

    const {
        data
    } = await supabaseClient.auth.getSession();

    if(data.session){

        currentUser =
        data.session.user;

        updateLoginButton();

    }

}


/* ==============================
   LOAD PROFILES
============================== */

async function loadProfiles(){

    const {
        data,
        error
    } = await supabaseClient
        .from("profiles")
        .select("*")
        .eq("profile_status","APPROVED")
        .order("created_at",{
            ascending:false
        });

    if(error){

        console.error(error);

        document.getElementById("profileGrid").innerHTML = `

        <div style="grid-column:1/-1;text-align:center;padding:40px">

        <h3 style="color:#4b001f">
        Unable to load profiles
        </h3>

        <p style="color:#777;margin-top:8px">
        Please check your Supabase connection.
        </p>

        </div>

        `;

        return;

    }

    allProfiles =
    data || [];

    displayProfiles(
        allProfiles.slice(0,8)
    );

}


/* ==============================
   DISPLAY
============================== */

function displayProfiles(profiles){

    const grid =
    document.getElementById(
        "profileGrid"
    );

    if(!profiles.length){

        grid.innerHTML = `

        <div style="
        grid-column:1/-1;
        text-align:center;
        padding:50px">

        <div style="
        font-size:45px;
        color:#4b001f">
        ♡
        </div>

        <h3 style="
        color:#4b001f;
        margin-top:10px">
        No profiles found
        </h3>

        <p style="
        color:#777;
        margin-top:8px">
        Try changing your search.
        </p>

        </div>

        `;

        return;

    }


    grid.innerHTML =
    profiles.map(profile => {

        let photo =
        profile.profile_photo;

        return `

        <div class="profile-card">

            <div class="profile-photo">

                ${
                    photo

                    ?

                    `<img
                    src="${escapeHtml(photo)}"
                    alt="${escapeHtml(profile.full_name)}"
                    onerror="this.style.display='none';this.parentElement.innerHTML='<div class=profile-placeholder>♡</div>'"
                    >`

                    :

                    `<div class="profile-placeholder">
                    ♡
                    </div>`
                }

            </div>


            <div class="profile-info">

                <div class="profile-name">
                    ${escapeHtml(profile.full_name)}
                </div>

                <div class="profile-location">
                    📍 ${escapeHtml(profile.location || "Kerala")}
                </div>

                <div class="profile-tags">

                    ${
                        profile.gender
                        ?
                        `<span class="tag">
                        ${escapeHtml(profile.gender)}
                        </span>`
                        :
                        ""
                    }

                    ${
                        profile.education
                        ?
                        `<span class="tag">
                        ${escapeHtml(profile.education)}
                        </span>`
                        :
                        ""
                    }

                    ${
                        profile.marital_status
                        ?
                        `<span class="tag">
                        ${escapeHtml(profile.marital_status)}
                        </span>`
                        :
                        ""
                    }

                </div>


                <div class="profile-actions">

                    <button
                    class="btn btn-outline"
                    onclick="viewProfile('${profile.id}')">

                    View

                    </button>

                    <button
                    class="btn btn-primary"
                    onclick="sendInterest('${profile.id}')">

                    Interest

                    </button>

                </div>

            </div>

        </div>

        `;

    }).join("");

}


/* ==============================
   SEARCH
============================== */

function searchProfiles(){

    const gender =
    document.getElementById(
        "searchGender"
    ).value;

    const location =
    document.getElementById(
        "searchLocation"
    ).value
    .toLowerCase()
    .trim();

    const marital =
    document.getElementById(
        "searchMarital"
    ).value;


    let result =
    allProfiles.filter(profile => {

        if(
            gender &&
            profile.gender !== gender
        ){
            return false;
        }

        if(
            location &&
            !(profile.location || "")
            .toLowerCase()
            .includes(location)
        ){
            return false;
        }

        if(
            marital &&
            profile.marital_status !== marital
        ){
            return false;
        }

        return true;

    });


    displayProfiles(result);

}


/* ==============================
   VIEW PROFILE
============================== */

async function viewProfile(id){

    const profile =
    allProfiles.find(
        p => p.id === id
    );

    if(!profile) return;


    let isPremium =
    profile.is_premium === true;

    let premiumEnd =
    profile.premium_end;

    if(
        premiumEnd &&
        premiumEnd < new Date()
        .toISOString()
        .slice(0,10)
    ){
        isPremium = false;
    }


    const modal =
    document.getElementById(
        "profileModal"
    );

    const details =
    document.getElementById(
        "profileDetails"
    );


    details.innerHTML = `

    <div class="modal-head">

        <div class="modal-photo">

            ${
                profile.profile_photo

                ?

                `<img
                src="${escapeHtml(profile.profile_photo)}"
                >`

                :

                `<div class="profile-placeholder">
                ♡
                </div>`
            }

        </div>

        <div>

            <h2 style="
            color:#4b001f;
            font-family:'Playfair Display',serif">

            ${escapeHtml(profile.full_name)}

            </h2>

            <p style="
            color:#777;
            margin-top:5px">

            📍 ${escapeHtml(profile.location || "-")}

            </p>

            ${
                profile.is_verified
                ?
                `<span class="tag"
                style="display:inline-block;margin-top:8px">
                ✓ Verified
                </span>`
                :
                ""
            }

        </div>

    </div>


    <div class="detail-grid">

        ${detail(
            "Gender",
            profile.gender
        )}

        ${detail(
            "Date of Birth",
            isPremium
            ? formatDate(profile.date_of_birth)
            : "Premium only"
        )}

        ${detail(
            "Education",
            isPremium
            ? profile.education
            : "Premium only"
        )}

        ${detail(
            "Profession",
            isPremium
            ? profile.profession
            : "Premium only"
        )}

        ${detail(
            "Marital Status",
            profile.marital_status
        )}

        ${detail(
            "Location",
            profile.location
        )}

    </div>


    ${
        isPremium

        ?

        `

        <div style="
        margin-top:20px;
        padding:20px;
        background:#fff6fa;
        border-radius:12px">

        <h3 style="
        color:#4b001f;
        font-family:'Playfair Display',serif;
        margin-bottom:8px">

        About

        </h3>

        <p style="
        color:#777;
        line-height:1.8">

        ${escapeHtml(
            profile.about ||
            "No information available."
        )}

        </p>

        </div>

        `

        :

        `

        <div class="premium-lock">

        <h3>
        🔒 Premium Profile
        </h3>

        <p style="
        color:#777;
        margin:10px 0 18px">

        Upgrade to Premium to view
        complete profile information,
        more photos and partner preferences.

        </p>

        <button
        class="btn btn-primary"
        onclick="premiumMessage()">

        Unlock Premium

        </button>

        </div>

        `
    }


    <div style="
    display:flex;
    gap:10px;
    margin-top:20px">

    <button
    class="btn btn-primary"
    onclick="sendInterest('${profile.id}')">

    Send Interest

    </button>

    </div>

    `;

    modal.classList.add("active");

}


/* ==============================
   DETAIL
============================== */

function detail(label,value){

    return `

    <div class="detail">

    <small>
    ${label}
    </small>

    <strong>
    ${escapeHtml(value || "-")}
    </strong>

    </div>

    `;

}


/* ==============================
   INTEREST
============================== */

async function sendInterest(receiverId){

    if(!currentUser){

        openLogin();

        showLoginMessage(
            "Please login to send interest.",
            "error"
        );

        return;

    }


    /*
       IMPORTANT:

       interests table should be created
       in Supabase before enabling this.
    */


    const {
        error
    } = await supabaseClient
        .from("interests")
        .insert({

            sender_id:
            currentUser.id,

            receiver_id:
            receiverId,

            status:
            "pending"

        });


    if(error){

        if(
            error.code === "42P01"
        ){

            alert(
                "Interests table is not created yet in Supabase."
            );

        }else{

            alert(
                error.message
            );

        }

        return;

    }


    alert(
        "Interest sent successfully ❤️"
    );

}


/* ==============================
   LOGIN
============================== */

function openLogin(){

    document
    .getElementById("loginModal")
    .classList.add("active");

}


function closeLogin(){

    document
    .getElementById("loginModal")
    .classList.remove("active");

}


function showLoginMessage(text,type){

    const box =
    document.getElementById(
        "loginMessage"
    );

    box.textContent =
    text;

    box.className =
    "message " + type;

}


document
.getElementById("loginForm")
.addEventListener(
"submit",
async function(e){

    e.preventDefault();


    const email =
    document.getElementById(
        "loginEmail"
    ).value;

    const password =
    document.getElementById(
        "loginPassword"
    ).value;


    const {
        data,
        error
    } =
    await supabaseClient.auth
    .signInWithPassword({

        email,
        password

    });


    if(error){

        showLoginMessage(
            error.message,
            "error"
        );

        return;

    }


    currentUser =
    data.user;

    showLoginMessage(
        "Login successful!",
        "success"
    );


    updateLoginButton();


    setTimeout(
        closeLogin,
        700
    );

});


/* ==============================
   LOGOUT
============================== */

async function logout(){

    await supabaseClient
    .auth
    .signOut();

    currentUser =
    null;

    updateLoginButton();

}


/* ==============================
   LOGIN BUTTON
============================== */

function updateLoginButton(){

    const buttons =
    document.querySelectorAll(
        ".nav-buttons .btn"
    );

    if(!buttons.length)
    return;


    if(currentUser){

        buttons[0].textContent =
        "Logout";

        buttons[0].onclick =
        logout;

    }else{

        buttons[0].textContent =
        "Login";

        buttons[0].onclick =
        openLogin;

    }

}


/* ==============================
   PREMIUM
============================== */

function premiumMessage(){

    if(!currentUser){

        openLogin();

        showLoginMessage(
            "Please login first to continue.",
            "error"
        );

        return;

    }


    alert(
        "Premium registration/payment page will be connected next."
    );

}


/* ==============================
   MOBILE MENU
============================== */

function toggleMenu(){

    const menu =
    document.getElementById(
        "mobileMenu"
    );

    menu.style.display =
    menu.style.display === "none"
    ?
    "block"
    :
    "none";

}


/* ==============================
   UTILITIES
============================== */

function formatDate(date){

    if(!date)
    return "-";

    return new Date(date)
    .toLocaleDateString(
        "en-IN"
    );

}


function escapeHtml(value){

    return String(
        value ?? ""
    ).replace(
        /[&<>"']/g,
        function(m){

            return {

                "&":"&amp;",
                "<":"&lt;",
                ">":"&gt;",
                '"':"&quot;",
                "'":"&#039;"

            }[m];

        }
    );

}


/* ==============================
   INIT
============================== */

document.addEventListener(
"DOMContentLoaded",
async function(){

    await checkUser();

    await loadProfiles();

});

</script>

