    .search-grid{
        grid-template-columns:1fr;
    }

    .profile-grid{
        grid-template-columns:1fr;
    }

    .detail-grid{
        grid-template-columns:1fr;
    }

    .footer-grid{
        grid-template-columns:1fr;
    }

}

</style>
</head>

