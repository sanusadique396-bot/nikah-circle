/* MODAL */

.modal{
    position:fixed;
    inset:0;
    background:rgba(25,5,15,.75);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:2000;
    padding:20px;
}

.modal.active{
    display:flex;
}

.modal-box{
    width:min(650px,100%);
    max-height:90vh;
    overflow:auto;
    background:#fff;
    border-radius:20px;
    padding:25px;
    position:relative;
}

.modal-close{
    position:absolute;
    right:18px;
    top:15px;
    border:none;
    background:none;
    font-size:25px;
    cursor:pointer;
}

.modal-head{
    display:flex;
    gap:20px;
    align-items:center;
    margin-bottom:20px;
}

.modal-photo{
    width:110px;
    height:110px;
    border-radius:15px;
    overflow:hidden;
    background:var(--pink);
}

.modal-photo img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.detail-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
}

.detail{
    padding:13px;
    background:var(--pink-light);
    border-radius:10px;
}

.detail small{
    display:block;
    color:var(--muted);
    margin-bottom:3px;
}

.detail strong{
    color:var(--primary);
}

/* LOGIN */

.login-modal{
    position:fixed;
    inset:0;
    background:rgba(40,5,20,.75);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:3000;
    padding:20px;
}

.login-modal.active{
    display:flex;
}

.login-box{
    width:min(420px,100%);
    background:#fff;
    border-radius:20px;
    padding:30px;
}

.login-box h2{
    font-family:"Playfair Display",serif;
    color:var(--primary);
    margin-bottom:10px;
}

.form-group{
    margin:15px 0;
}

.form-group label{
    display:block;
    font-size:13px;
    font-weight:700;
    margin-bottom:6px;
}

.message{
    padding:10px;
    border-radius:8px;
    margin:10px 0;
    font-size:13px;
    display:none;
}

.message.error{
    background:#fff0f2;
    color:#b21f35;
    display:block;
}

.message.success{
    background:#e9f8ef;
    color:#167246;
    display:block;
}

/* PREMIUM */

.premium-lock{
    text-align:center;
    padding:30px;
    background:var(--pink-light);
    border-radius:15px;
    margin-top:20px;
}

.premium-lock h3{
    color:var(--primary);
    font-family:"Playfair Display",serif;
}

@media(max-width:1000px){

    .profile-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .search-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .hero h1{
        font-size:45px;
    }

}

@media(max-width:800px){

    .nav-links,
    .nav-buttons{
        display:none;
    }

    .menu-btn{
        display:block;
    }

    .nav-mobile{
        display:flex!important;
    }

    .hero-grid,
    .about-grid{
        grid-template-columns:1fr;
    }

    .steps{
        grid-template-columns:1fr;
    }

    .footer-grid{
        grid-template-columns:1fr 1fr;
    }

}

@media(max-width:600px){

    .hero{
        padding:60px 0;
    }

    .hero h1{
